<Page MinWidth="1024" MinHeight="576"
    x:Class="Launcher.ProjectGeneratorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Launcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid MinHeight="576" MinWidth="1024" Background="#0E1116">

        <ProgressBar Visibility="Collapsed" x:Name="_progressBar" IsEnabled="False" IsIndeterminate="True" MinHeight="25" MinWidth="500" HorizontalAlignment="Center"
                     Canvas.ZIndex="4"/>
        <TextBlock x:Name="_warningText" Visibility="Collapsed" Foreground="Orange" FontWeight="ExtraBold" FontFamily="ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-Bold.ttf" IsColorFontEnabled="True" Background="Transparent" Text="THE LAUNCHER IS CONFIGURARING THE PROJECT. DO NOT CLOSE!" Margin="0,50,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                Canvas.ZIndex="4"/>
        <Grid Background="#212833" VerticalAlignment="Bottom" Canvas.ZIndex="1">
            <TextBox TextWrapping="Wrap" MaxWidth="640" MaxHeight="32" MaxLength="4096" x:Name="_existingProjectPath"
                     FontFamily="ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans.ttf" FontSize="12" IsReadOnly="True" MinWidth="640" Margin="310,5,0,15" HorizontalAlignment="Left" />
            
            <Button Foreground="AliceBlue" Click="OnClickSelectFroggy" Margin="5,5,0,15" FontSize="12" FontWeight="Bold" FontFamily="ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-Bold.ttf" Content="Locate an existing project from the directory:" VerticalAlignment="Bottom" />
            <Button x:Name="_buttonAdd"
                    Click="OnClickAdd"
                    Foreground="AliceBlue" FontWeight="Bold" FontSize="12" Content="Add" Margin="5,5,20,15" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
        </Grid>

        <StackPanel Margin="2.5,100,0,0" HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Top">
            <Image x:Name="_exeImage"
                   Margin="46,10,0,0" VerticalAlignment="Center" MaxWidth="70" HorizontalAlignment="Center" Source="Assets/Icons/exe.png" />
        
            <Image x:Name="_gameImage"
                   Margin="66,0,0,0" MaxWidth="120" VerticalAlignment="Center" HorizontalAlignment="Center" Source="Assets/Icons/iconLargeTile.scale-400.png" />
        
            <Image x:Name="_dllImage"
                   Margin="48,0,0,0" MaxWidth="100" Source="Assets/Icons/dll.png" />
        
            <Image x:Name="_libImage"
                   Margin="60,0,0,0" Source="Assets/Icons/lib.png" MaxWidth="100" />
        
        </StackPanel>

        <StackPanel Margin="2.5,100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal">
            <ToggleButton Foreground="AliceBlue" x:Name="_selectedEXE"
                          Style="{StaticResource DateTimePickerFlyoutButtonStyle}"
                          Margin="5,0" HorizontalAlignment="Center" Padding="48.5,121,48.5,10"
                          FontFamily="ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-Bold.ttf"
                          Content="CLI APP" FontWeight="SemiBold"
                          Click="OnSelectEXE" />
            <ToggleButton Foreground="AliceBlue" x:Name="_selectedGame"
                          Style="{StaticResource DateTimePickerFlyoutButtonStyle}" Margin="5,0" HorizontalAlignment="Center" Padding="54.5,121,54.5,10" FontFamily="ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-Bold.ttf" FontWeight="SemiBold" Content="GAME"
                          Click="OnSelectGame" />
            <ToggleButton Foreground="AliceBlue" x:Name="_selectedDLL"
                          Style="{StaticResource DateTimePickerFlyoutButtonStyle}" Margin="5,0" Padding="10,121,10,10" Content="DYNAMIC LIBRARY" FontFamily="ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-Bold.ttf" FontWeight="SemiBold" HorizontalAlignment="Center"
                          Click="OnSelectDLL" />
            <ToggleButton Foreground="AliceBlue" x:Name="_selectedLIB"
                          Style="{StaticResource DateTimePickerFlyoutButtonStyle}" Margin="5,0" HorizontalAlignment="Center" Padding="20,121,20,10" FontWeight="SemiBold" FontFamily="ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-Bold.ttf" Content="STATIC LIBRARY"
                          Click="OnSelectLIB"/>
        </StackPanel>

        <Grid Padding="5,0" Background="#0E1116" HorizontalAlignment="Right">
            <Button Foreground="AliceBlue" Click="OnClickSelectFolder"
                    VerticalAlignment="Bottom" Margin="1,0,0,115" FontSize="12" FontFamily="ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-Bold.ttf" Content="SET PROJECT DIRECTORY" />
            
            <Button Foreground="AliceBlue" Click="OnClickCreate"
                    VerticalAlignment="Bottom" Margin="170,0,0,115" FontFamily="ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-Bold.ttf" FontSize="12" Content="CREATE" />

            <TextBox Margin="0,0,0,80" TextWrapping="Wrap" IsReadOnly="True" x:Name="_newProjectDirectory" MaxHeight="64" MaxWidth="360" FontFamily="ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans.ttf" FontSize="10" MaxLength="4096" VerticalAlignment="Bottom" />

            <TextBox x:Name="_newProjectName" Margin="0,0,0,160" TextWrapping="Wrap" MaxLength="256" VerticalAlignment="Bottom" />

            <TextBlock Foreground="AliceBlue" HorizontalAlignment="Left" Text="PROJECT NAME:" FontSize="12" FontFamily="ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-Bold.ttf" Margin="2.5,0,0,197.5" VerticalAlignment="Bottom" />

            <TextBox x:Name="_selectedEngineVersion" IsReadOnly="True" VerticalAlignment="Bottom" Margin="0,0,0,225" MaxLength="256" />

            <TextBlock Foreground="AliceBlue" Margin="2.5,0,0,262.5" VerticalAlignment="Bottom" FontFamily="ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-Bold.ttf" FontSize="12" Text="TARGET ENGINE VERSION:" HorizontalAlignment="Left" />

         <TextBlock Foreground="OrangeRed" x:Name="_errorText" IsColorFontEnabled="True" FontWeight="ExtraBold" FontFamily="ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-Bold.ttf" Margin="2.5,0,0,55" VerticalAlignment="Bottom" />
            <Image x:Name="_selectedProjectType"
                   Margin="0,45,10,0" VerticalAlignment="Top" HorizontalAlignment="Center" MaxHeight="250" MaxWidth="250" Source="Assets/Icons/FE.png" />

            <Border Margin="0,0,360,0" Background="#212833" BorderThickness="0.4" BorderBrush="#212833" HorizontalAlignment="Right" />
        </Grid>
        
    </Grid>
    
</Page>
