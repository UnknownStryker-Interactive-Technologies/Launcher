<Page MinHeight="504" MinWidth="896"
    x:Class="Launcher.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Launcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid MinWidth="896" MinHeight="504" Background="#0E1116"
          Canvas.ZIndex="0">

        <Button x:Name="_buttonNewProject"
                Visibility="Visible"
                FontSize="10" FontWeight="Bold" UseSystemFocusVisuals="False" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right"
                Width="44"
                Height="44"
                Command="{Binding AddCommand}"
                Foreground="AliceBlue"
                Background="#161B22"
                Canvas.ZIndex="2"
                Click="OnClickNewProject">
            <SymbolIcon Foreground="AliceBlue"
                        Background="#161B22" 
                        MinHeight="44" MinWidth="44"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Symbol="Add"
                        Canvas.ZIndex="2"/>
        </Button>

        <TextBlock FontWeight="SemiBold" x:Name="_textEngineVersions" FontSize="25" FontFamily="Arial Black" TextAlignment="Justify"
                   Margin="260,27,0,0"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   TextWrapping="WrapWholeWords" 
                   Text="ENGINE VERSIONS"
                   Canvas.ZIndex="2"
                   Foreground="AliceBlue"
                   Background="#0E1116"/>
        
        <TextBlock FontWeight="SemiBold" x:Name="_textProjects" FontSize="25" FontFamily="ms-appx:///Uno.Fonts.Fluent/Fonts/uno-fluentui-assets.ttf" TextAlignment="Justify"
                   Margin="260,0,0,7"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   TextWrapping="WrapWholeWords"
                   Text="PROJECTS"
                   Canvas.ZIndex="2"
                   Foreground="AliceBlue"
                   Background="#0E1116"/>

        <Button FontFamily="ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-Bold.ttf" UseSystemFocusVisuals="False" x:Name="_launchEngineInstaller"
                FontWeight="Bold"
                Style="{StaticResource AccentButtonStyle}"
                Content="Launch Engine Installer"
                Margin="0,8,8,0"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Foreground="AliceBlue"
                Background="#161B22" 
                Click="OnClickLaunchEngineInstaller" />
        
        <WebView2 Margin="251,0,0,22" x:Name="_docsWebView"
                  IsEnabled="False"
                  Visibility="Collapsed" />

    <Grid x:Name="_engineVersionGrid" Background="#0E1116" Margin="260,70,10,0" VerticalAlignment="Top">
        <GridView IsItemClickEnabled="True"
                  ItemClick="OnClickEngineVersion"
                  Padding="0" VerticalAlignment="Top" 
                  ItemsSource="{x:Bind _engineVersions}"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  SelectionMode="Single">
            
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:EngineInfo">
                        <Grid Background="#161B22">
                            <Image HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,5,0,40"
                                   Source="/Assets/Icons/FE.png" Width="64" Height="64"/>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Margin="100,10,10,0"
                                       Text="Frogman Engine " FontSize="18" FontWeight="Bold" Foreground="AliceBlue"/>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,30,15,0"
                                       Text="{x:Bind Version}" FontSize="10" FontWeight="Bold" Foreground="AliceBlue"/>

                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,10,0,10"
                                       Text="path: " FontSize="10" Foreground="Gray"/>
                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,10,0,10"
                                       Text="{x:Bind InstallationPath}" FontSize="10" Foreground="Gray"
                                       TextWrapping="NoWrap" MinWidth="128" MaxWidth="4096"/>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>

            </GridView>
    </Grid>

     <ScrollViewer x:Name="_scrollableProjectList" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled" MinWidth="900" MaxWidth="900" MaxHeight="180" MinHeight="180" Margin="260,300,0,0" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Center">
        <GridView HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Left" IsItemClickEnabled="True"
              ItemClick="OnSelectProject"
              Padding="0"  
              ItemsSource="{x:Bind _projects}"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              SelectionMode="Single">
        
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:Froggy">
                    <Grid Background="#161B22">
                        <Image HorizontalAlignment="Center" VerticalAlignment="Top"
                               Source="/Assets/Icons/FE.png" Width="64" Height="64" Margin="0,10,0,100"/>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0" MinWidth="256" MaxWidth="256" TextAlignment="Center"
                                   Text="{x:Bind ProjectInfo.ProjectName}" FontSize="18" FontWeight="Bold" Foreground="AliceBlue"/>
                        
                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,40" TextAlignment="Center"
                                   Text="type: " FontSize="10" Foreground="Gray"/>
                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,0,40" TextAlignment="Center"
                                   Text="{x:Bind ProjectInfo.ProjectType}" FontSize="10" Foreground="Gray"/>
        
                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,25" TextAlignment="Center"
                                   Text="path: " FontSize="10" Foreground="Gray"/>
                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,10,25" MinWidth="256" MaxWidth="256" TextAlignment="Left"
                                   Text="{x:Bind ProjectInfo.ProjectPath}" FontSize="10" Foreground="Gray"/>
        
                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10" TextAlignment="Center"
                                   Text="Frogman Engine " FontSize="10" Foreground="Gray"/>
                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="90,0,0,10" TextAlignment="Center"
                                   Text="{x:Bind EngineInfo.Version}" FontSize="10" Foreground="Gray"/>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        
        </GridView>
</ScrollViewer>
        
        <Grid ColumnDefinitions="*" Padding="5"
              Canvas.ZIndex="2"
              VerticalAlignment="Bottom"
              Background="#161B22">
            <TextBlock HorizontalAlignment="Right" FontWeight="Bold" FontFamily="ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-Bold.ttf"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Text="Copyright © from 2022 to present, UNKNOWN STRYKER. All Rights Reserved."
                       Foreground="AliceBlue" />
        </Grid>

        <Border 
                BorderThickness="0.4"
                Margin="250,0,0,0"
                HorizontalAlignment="Left"
                BorderBrush="#212833" Background="#212833"
                Canvas.ZIndex="1" />
        <!-- Content here -->

        <!-- 161B22 212833 -->

        <Border x:Name="_borderOnTheTop"
                BorderThickness="0.4"
                Margin="0,44,0,0"
                VerticalAlignment="Top"
                BorderBrush="#212833" Background="#212833"
                Canvas.ZIndex="1"
                Visibility="Collapsed">
        </Border>

        <Border x:Name="_border"
                BorderThickness="0.4"
                VerticalAlignment="Center"
                BorderBrush="#212833" Background="#212833"
                Canvas.ZIndex="1"
                >
        </Border>

        <Grid HorizontalAlignment="Left"
              Background="#0E1116"
              Width="250"
              Canvas.ZIndex="3">

            <Button FontFamily="ms-appx:///Uno.Fonts.OpenSans/Fonts/OpenSans-Bold.ttf" Content="SIGN OUT" FontWeight="Bold" MinHeight="40" FontSize="15"
                    Margin="0,0,4,25"
                    VerticalAlignment="Bottom"
                    MinWidth="85"
                    Style="{StaticResource AlternateCloseButtonStyle}"
                    Foreground="AliceBlue"
                    Click="OnClickSignOut"/>

            <TextBlock Margin="0,150,0,0"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       Text="FROGMAN"
                       FontSize="35"
                       TextAlignment="Right"
                       FontFamily="ms-appx:///Uno.Fonts.Fluent/Fonts/uno-fluentui-assets.ttf"
                       Foreground="AliceBlue"
                       FontWeight="Bold" />
            
            <TextBlock FontWeight="Bold" FontFamily="ms-appx:///Uno.Fonts.Fluent/Fonts/uno-fluentui-assets.ttf"
                       Margin="0,190,0,0"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       FontSize="35" Text="ENGINE"
                       Foreground="AliceBlue" />
            
            <StackPanel HorizontalAlignment="Right" Padding="0,250,8,0" Spacing="20" VerticalAlignment="Top">
                <!-- App Title -->

                <!-- Custom Tabs -->
                <Button Width="100" FontWeight="SemiBold" HorizontalAlignment="Center" HorizontalContentAlignment="Right" 
                        VerticalAlignment="Center"
                        Content="NEWS"
                        Style="{StaticResource AlternateCloseButtonStyle}"
                        FontSize="25"
                        Click="OnClickNews"
                        Foreground="AliceBlue" />

                <Button Width="100" FontWeight="SemiBold" HorizontalContentAlignment="Right" HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Content="ENGINE"
                        Style="{StaticResource AlternateCloseButtonStyle}"
                        FontSize="25"
                        Click="OnClickEngine"
                        Foreground="AliceBlue" />

                <Button FontWeight="SemiBold" HorizontalAlignment="Center" HorizontalContentAlignment="Right" Width="100" 
                        VerticalAlignment="Center"
                        Content="GUIDE"
                        Style="{StaticResource AlternateCloseButtonStyle}"
                        FontSize="25"
                        Click="OnClickGuide"
                        Foreground="AliceBlue" />
                
            </StackPanel>
            <Image Margin="0,15,0,0" MaxHeight="125" MaxWidth="125" VerticalAlignment="Top" Source="Assets/Icons/FE.png" />
        </Grid>
        
    </Grid>

</Page>
